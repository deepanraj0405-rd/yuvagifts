# Port for local web server
PORT=3000

# MongoDB Connection String:
# 1. Local MongoDB: mongodb://localhost:27017/yuvagifts
# 2. MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/yuvagifts?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/yuvagifts
